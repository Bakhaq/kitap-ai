# Осы файлды .env деп көшіріп, мәндерді өзгертіңіз. .env репозиторийге жүктелмейді.
POSTGRES_DB=projectdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=change_me
REPLICATION_PASSWORD=change_me
SECRET_KEY=change_me_long_random_string
# Сайт алғаш іске қосылғанда осы деректермен әкімші жасалады (тіркелу формасы admin рөлін бермейді)
ADMIN_EMAIL=admin@kitap-ai.example
ADMIN_PASSWORD=change_me
# Байланыстар бетіндегі GitHub репозиторийінің сілтемесі
GITHUB_URL=https://github.com/<github-логин>/kitap-ai-lab11
